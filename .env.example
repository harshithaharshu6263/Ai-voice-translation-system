# Copy to .env to enable email. Never commit .env.
PORT=8500
HOST=127.0.0.1
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Demo account: harshita@gmail.com / 1234. Set false for new non-demo installs.
DEMO_LOGIN=true
# Set true only when serving over HTTPS.
COOKIE_SECURE=false
